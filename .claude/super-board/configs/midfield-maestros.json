{
  "version": 1,
  "description": "midfield-maestros build pipeline",
  "project": {
    "owner": "hcn35",
    "title": "Midfield Maestros",
    "number": 1
  },
  "worker_backend": "workflow",
  "model_tier": "medium",
  "target": {
    "type": "repo",
    "url": null
  },
  "repo": {
    "path": ".",
    "remote": "https://github.com/hcn35/midfield-maestros"
  },
  "base_branch": "staging",
  "timezone": "America/New_York",
  "columns": [
    "Backlog",
    "Ready",
    "Building",
    "QA",
    "Review",
    "Blocked",
    "Done"
  ],
  "labels": [
    "qa",
    "bug",
    "feature"
  ],
  "paths": {
    "project_md": "docs/super-board/PROJECT.md",
    "pre_flight_md": "docs/super-board/pre-flight.md",
    "runs_dir": "docs/super-board/runs"
  },
  "human_approves_merge": false,
  "merge_policy": {
    "default": "auto",
    "auto_max_lines": 400,
    "allow_auto_on_production": false,
    "size_exclude": [
      "**/package-lock.json",
      "**/yarn.lock",
      "**/pnpm-lock.yaml",
      "**/bun.lockb",
      "**/bun.lock",
      "**/npm-shrinkwrap.json",
      "**/Cargo.lock",
      "**/poetry.lock",
      "**/uv.lock",
      "**/Pipfile.lock",
      "**/Gemfile.lock",
      "**/composer.lock",
      "**/go.sum",
      "**/Podfile.lock",
      "**/pubspec.lock",
      "**/generated/**",
      "**/__generated__/**",
      "**/*.generated.*",
      "**/*.gen.*",
      "**/*.min.js",
      "**/*.min.css",
      "**/*.map",
      "**/*.pb.go",
      "**/*_pb2.py",
      "**/__snapshots__/**",
      "**/*.snap",
      "tests/fixtures/**"
    ]
  },
  "migrations": {
    "allowed_envs": [
      "test",
      "staging"
    ],
    "target_env": "staging",
    "commands": {},
    "checks": {},
    "human_steps": []
  },
  "verify_commands": [
    "python3.11 -m venv .venv && .venv/bin/pip install -e '.[dev]' && .venv/bin/pytest"
  ],
  "max_workers": 0,
  "collect": {
    "sources": [
      "github",
      "prs",
      "architecture"
    ],
    "window_days": 14,
    "custom": []
  },
  "notifications": {
    "channel": "session",
    "chat_id": null,
    "bot_identity": "hcn35"
  },
  "truth_gate": "non-trivial",
  "truth_threshold": 70
}
